# MySQL 8 (Plesk > Databases). Create an empty database and a user with full rights on it.
DATABASE_URL=mysql://safety_user:change-me@localhost:3306/safety_alchemist

# Public URL of the app (used in emails and sign-in links)
APP_URL=https://safetyalchemist.com

# OVH Object Storage (S3-compatible) for inspection and correction photos. Not used yet.
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=safety-alchemist-photos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Outbound email for Member sign-in links and reminders (local server SMTP default).
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Safety Alchemist <reports@safetyalchemist.com>"

# Demo only: lets the sidebar switch between Owner / Admin / Supervisor until real auth is in.
DEMO_ROLE_SWITCH=true
