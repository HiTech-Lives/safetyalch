# MySQL 8 (Plesk > Databases). Create an empty database and a user with full rights on it.
DATABASE_URL=mysql://safety_user:change-me@localhost:3306/safety_alchemist

# Public URL of the app (used in emails and sign-in links)
APP_URL=https://safetyalchemist.com

# OVH Object Storage (S3-compatible) for inspection and correction photos. Not used yet.
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=safety-alchemist-photos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Outbound email for Member sign-in links and reminders (local server SMTP default).
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Safety Alchemist <reports@safetyalchemist.com>"

# Demo only: lets the sidebar switch between Owner / Admin / Supervisor until real auth is in.
DEMO_ROLE_SWITCH=true

# Multi-Cloud AI Routing (Default: aws_bedrock with Qwen / Nova, or azure_ai, openai_compat, gemini, anthropic, deterministic)
AI_PROVIDER=aws_bedrock
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_ENDPOINT=
AWS_BEDROCK_API_KEY=
AI_TEXT_MODEL=qwen.qwen2.5-32b-instruct-v1:0
AI_VISION_MODEL=qwen.qwen2.5-vl-72b-instruct

# Azure AI Foundry / Azure OpenAI (Optional alternative cloud provider)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=2024-05-01-preview
AZURE_AI_MODEL=Qwen2.5-32B-Instruct

# ElevenLabs Voice AI (Speech-to-Text Scribe v1 for Field Voice Memos & TTS for Truck Briefings)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
